    <GeneDef Name="SG_GeneEatSpeedUpPlus" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneEatSpeedUpPlus</defName>
        <label>inhales food</label>
        <labelShortAdj>inhales-food</labelShortAdj>
