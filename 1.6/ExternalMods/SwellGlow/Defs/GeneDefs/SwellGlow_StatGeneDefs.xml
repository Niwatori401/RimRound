<Defs>
    <GeneDef Name="SG_GeneDigestDown" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneDigestDown</defName>
        <label>slow digestion</label>
        <labelShortAdj>slow-digestion</labelShortAdj>
        <description>Carriers of this gene digest food slowly. They'll be full for a long time.</description>
        <iconPath>Genes/DigestionDown</iconPath>
        <displayOrderInCategory>111</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitDigestDown</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>DigestionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneDigestUp" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneDigestUp</defName>
        <label>fast digestion</label>
        <labelShortAdj>fast-digestion</labelShortAdj>
        <description>Carriers of this gene digest food quicker than most people. They'll be ready to eat again sooner rather than later.</description>
        <iconPath>Genes/DigestionUp</iconPath>
        <displayOrderInCategory>110</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitDigestUp</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>DigestionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneDigestUpPlus" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneDigestUpPlus</defName>
        <label>ultra digestion</label>
        <labelShortAdj>ultra-digestion</labelShortAdj>
        <description>Carriers of this gene digest food at a speed unheard of to most people.</description>
        <iconPath>Genes/DigestionUpPlus</iconPath>
        <displayOrderInCategory>111</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitDigestUpPlus</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>DigestionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>


    <GeneDef Name="SG_GeneWeightDownPlus" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightDownPlus</defName>
        <label>ultra metabolism</label>
        <labelShortAdj>ultra-metabolism</labelShortAdj>
        <description>Carriers of this gene burn through calories like they aren't even there. It'll take some serious effort for them to gain any weight.</description>
        <iconPath>Genes/WeightDownPlus</iconPath>
        <displayOrderInCategory>113</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitWeightGainDownPlus</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>WeightGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightDown" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightDown</defName>
        <label>fast metabolism</label>
        <labelShortAdj>fast-metabolism</labelShortAdj>
        <description>Carriers of this gene burn calories quicker than most people. It'll take a lot more food for them to gain weight.</description>
        <iconPath>Genes/WeightDown</iconPath>
        <displayOrderInCategory>113</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitWeightGainDown</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>WeightGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightUp" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightUp</defName>
        <label>slow metabolism</label>
        <labelShortAdj>slow-metabolism</labelShortAdj>
        <description>Carriers of this gene burn calories slowly. They may gain some extra weight as a result.</description>
        <iconPath>Genes/WeightUp</iconPath>
        <displayOrderInCategory>112</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitWeightGainUp</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>WeightGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightUpPlus" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightUpPlus</defName>
        <label>ultra slow metabolism</label>
        <labelShortAdj>ultra-slow-metabolism</labelShortAdj>
        <description>Carriers of this gene burn calories very slowly. Much of the food they eat will end up as added weight.</description>
        <iconPath>Genes/WeightUpPlus</iconPath>
        <displayOrderInCategory>112</displayOrderInCategory>
        <forcedTraits>
            <li>
            <def>SG_TraitWeightGainUpPlus</def>
            </li>
        </forcedTraits>
        <exclusionTags>
            <li>WeightGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>


