<Defs>
    <GeneDef Name="SG_GeneWeightHate" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightHate</defName>
        <label>hate weight gain</label>
        <labelShortAdj>weight-hate</labelShortAdj>
        <description>Carriers of this gene despise the idea of carrying any amount of extra weight.</description>
        <iconPath>Genes/Opinion/WOHate</iconPath>
        <geneClass>SwellGlow.SGGene</geneClass>
        <displayOrderInCategory>100</displayOrderInCategory>
        <modExtensions>
            <li Class="SwellGlow.SGTraitExtension">
                <opinionTrait>Hate</opinionTrait>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightDislike" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightDislike</defName>
        <label>dislike weight gain</label>
        <labelShortAdj>weight-dislike</labelShortAdj>
        <description>Carriers of this gene like to be thin and will be upset if they gain weight.</description>
        <iconPath>Genes/Opinion/WODislike</iconPath>
        <geneClass>SwellGlow.SGGene</geneClass>
        <displayOrderInCategory>101</displayOrderInCategory>
        <modExtensions>
            <li Class="SwellGlow.SGTraitExtension">
                <opinionTrait>Dislike</opinionTrait>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightNeutralMinus" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightNeutralMinus</defName>
        <label>slightly dislike weight gain</label>
        <labelShortAdj>weight-slight-dislike</labelShortAdj>
        <description>Carriers of this gene generally prefer to be thinner but don't hate the idea of a little meat on their bones.</description>
        <iconPath>Genes/Opinion/WONeutralMinus</iconPath>
        <geneClass>SwellGlow.SGGene</geneClass>
