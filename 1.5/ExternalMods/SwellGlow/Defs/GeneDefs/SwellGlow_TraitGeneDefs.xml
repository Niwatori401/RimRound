        <geneClass>SwellGlow.SGGene</geneClass>
        <displayOrderInCategory>106</displayOrderInCategory>
        <modExtensions>
            <li Class="SwellGlow.SGTraitExtension">
                <opinionTrait>Love</opinionTrait>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
