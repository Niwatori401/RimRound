            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightLike" MayRequire="Ludeon.RimWorld.Biotech">
