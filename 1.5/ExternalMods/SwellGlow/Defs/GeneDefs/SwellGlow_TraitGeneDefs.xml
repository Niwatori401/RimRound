            <li Class="SwellGlow.SGTraitExtension">
                <opinionTrait>NeutralMinus</opinionTrait>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightNeutral" MayRequire="Ludeon.RimWorld.Biotech">
        <defName>SG_GeneWeightNeutral</defName>
        <label>neutral to weight gain</label>
        <labelShortAdj>weight-neutral</labelShortAdj>
        <description>Carriers of this gene believe that fat is just fat. While they don't want to be huge, they can appreciate bodies with a little extra weight on them.</description>
        <iconPath>Genes/Opinion/WONeutral</iconPath>
        <geneClass>SwellGlow.SGGene</geneClass>
        <displayOrderInCategory>103</displayOrderInCategory>
        <modExtensions>
            <li Class="SwellGlow.SGTraitExtension">
                <opinionTrait>Neutral</opinionTrait>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>
    <GeneDef Name="SG_GeneWeightNeutralPlus" MayRequire="Ludeon.RimWorld.Biotech">
