<Defs>
    <!--─────────────────────────────────────────────────────────────
  DIGESTION‑SPEED TRAITS
───────────────────────────────────────────────────────────────-->
<TraitDef>
  <defName>SG_TraitDigestDown</defName>
  <commonality>2</commonality>
  <degreeDatas>
    <li>
      <degree>0</degree>
      <label>slow digestion</label>
      <description>[PAWN_nameDef] digests food slowly. [PAWN_pronoun]'ll be full for a long time.</description>
    </li>
  </degreeDatas>
  <conflictingTraits>
    <li>SG_TraitDigestUp</li>
    <li>SG_TraitDigestUpPlus</li>
  </conflictingTraits>
  <modExtensions>
    <li Class="SwellGlow.SGTraitStatExtension">
      <digestionSpeedMultBonus>-0.5</digestionSpeedMultBonus>
    </li>
  </modExtensions>
</TraitDef>

<TraitDef>
  <defName>SG_TraitDigestUp</defName>
  <commonality>2</commonality>
  <degreeDatas>
    <li>
      <degree>0</degree>
      <label>fast digestion</label>
      <description>[PAWN_nameDef] digests food quicker than most people. [PAWN_pronoun]'ll be ready to eat again sooner rather than later.</description>
    </li>
  </degreeDatas>
  <conflictingTraits>
    <li>SG_TraitDigestDown</li>
    <li>SG_TraitDigestUpPlus</li>
  </conflictingTraits>
  <modExtensions>
    <li Class="SwellGlow.SGTraitStatExtension">
      <digestionSpeedMultBonus>0.5</digestionSpeedMultBonus>
    </li>
  </modExtensions>
</TraitDef>

<TraitDef>
  <defName>SG_TraitDigestUpPlus</defName>
  <commonality>2</commonality>
  <degreeDatas>
    <li>
      <degree>0</degree>
      <label>ultra digestion</label>
      <description>[PAWN_nameDef]'s stomach spells doom for all food. [PAWN_pronoun] digests {PAWN_possessive} food at a speed unheard of to most people.</description>
    </li>
  </degreeDatas>
  <conflictingTraits>
    <li>SG_TraitDigestDown</li>
    <li>SG_TraitDigestUp</li>
  </conflictingTraits>
  <modExtensions>
    <li Class="SwellGlow.SGTraitStatExtension">
      <digestionSpeedMultBonus>1</digestionSpeedMultBonus>
    </li>
  </modExtensions>
</TraitDef>


