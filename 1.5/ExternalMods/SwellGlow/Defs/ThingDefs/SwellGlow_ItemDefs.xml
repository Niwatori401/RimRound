	<!--Implants-->
	<HediffDef ParentName="RR_AddedBodyPartBase">
		<defName>SG_ImplantHediff</defName>
		<label>Swell-Glow implant</label>
		<labelNoun>a swell-glow implant</labelNoun>
		<hediffClass>SwellGlow.SGImplant</hediffClass>
		<initialSeverity>0.05</initialSeverity>
		<alwaysShowSeverity>true</alwaysShowSeverity>
		<description>An installed Swell-Glow implant.</description>
		<descriptionHyperlinks><ThingDef>SG_SwellGlowImplant</ThingDef></descriptionHyperlinks>
	</HediffDef>

	<ThingDef ParentName="RimRound_BodyPartBionicBase">
		<defName>SG_SwellGlowImplant</defName>
		<label>swell-glow implant</label>
		<description>Want to take the magic of Swell-Glow wherever you go? This state-of-the-art implant uses calorite to constantly synthesize Swell-Glow within your own body! Never be without Swell-Glow again! Supports multiple implants, but since the activated calorite irreversibly binds with the stomach lining, it cannot be removed without replacing the stomach.</description>
		<graphicData>
			<texPath>Things/SwellGlow/SwellGlowImplant</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<descriptionHyperlinks><RecipeDef>SG_InstallSwellGlowImplant</RecipeDef></descriptionHyperlinks>
		<costList>
			<RR_Gluttonium>5</RR_Gluttonium>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<thingSetMakerTags><li>RewardStandardMidFreq</li></thingSetMakerTags>

		<statBases>
			<WorkToMake>5280</WorkToMake>
			<Mass>2</Mass>
		</statBases>

		<recipeMaker>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<researchPrerequisite>RR_Research_HungerImplant</researchPrerequisite>
		</recipeMaker>	
	</ThingDef>

	<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
		<defName>SG_InstallSwellGlowImplant</defName>
		<label>install swell-glow implant</label>
		<description>Install a swell-glow implant.</description>
		<descriptionHyperlinks>
			<ThingDef>SG_SwellGlowImplant</ThingDef>
			<HediffDef>SG_ImplantHediff</HediffDef>
		</descriptionHyperlinks>
		<workerClass>SwellGlow.Recipe_InstallImplantAllowDuplicates</workerClass>
		<jobString>Installing swell-glow implant.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>SG_SwellGlowImplant</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>SG_SwellGlowImplant</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Stomach</li>
		</appliedOnFixedBodyParts>
		<addsHediff>SG_ImplantHediff</addsHediff>
	</RecipeDef>

	<!--Food-->
	<ThingDef ParentName="OrganicProductBase">
