<Defs>
	<!--Drugs-->
	<ThingDef ParentName="swellGlowDrugBase">
		<defName>swellGlowOriginal</defName>
		<label>Swell-Glow</label>
		<description>Calorite based pills from one of the most hedonistic glitterworld societies. Low-strength tasters for lightly softening your figure.</description>
		<tradeTags>
			<li>Drugs</li>
		</tradeTags>
		<graphicData>
			<texPath>Things/SwellGlow/SwellGlow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>25</MarketValue>
			<WorkToMake>375</WorkToMake>
			<Nutrition>15</Nutrition>
			<Mass>0.005</Mass>
		</statBases>
		<ingestible>
            <outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>swellGlowHigh</hediffDef>
					<severity>0.20</severity>
					<toleranceChemical>swellGlowChem</toleranceChemical>
				</li>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>swellGlowTolerance</hediffDef>
					<severity>0.080</severity>
					<divideByBodySize>true</divideByBodySize>
				</li>
			</outcomeDoers>
			<baseIngestTicks>100</baseIngestTicks>
			<chairSearchRadius>4</chairSearchRadius>
			<preferability>DesperateOnly</preferability>
			<tasteThought></tasteThought>
			<foodType>Processed</foodType>
			<joyKind>Chemical</joyKind>
			<joy>0.10</joy>
			<nurseable>true</nurseable>
			<drugCategory>Social</drugCategory>
			<ingestSound>Meal_Eat</ingestSound>
		</ingestible>
		<comps>
			<li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
				<compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
				<fullnessToNutritionRatio>.001</fullnessToNutritionRatio>
			</li>
            <li Class="CompProperties_Drug">
				<chemical>swellGlowChem</chemical>
				<addictiveness>0.20</addictiveness>
				<minToleranceToAddict>0.005</minToleranceToAddict>
				<existingAddictionSeverityOffset>0.1</existingAddictionSeverityOffset>
				<needLevelOffset>0.9</needLevelOffset>
				<listOrder>30</listOrder>
			</li>
		</comps>
		<allowedArchonexusCount>20</allowedArchonexusCount>
	</ThingDef>
